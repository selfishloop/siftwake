+++ b/tests/owned_watermark.rs
@@ -0,0 +1,149 @@
+#![cfg(feature = "bounded-engine")]
+use fdb::{Database, Document, Error, Guard, Key, Mutation, Options, Query};
+use std::fs;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static NEXT: AtomicU64 = AtomicU64::new(0);
+struct Temp(PathBuf);
+impl Temp {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "fdb-owned-watermark-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&path).unwrap();
+        Self(path)
+    }
+}
+impl Drop for Temp {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+fn document(id: &str) -> Document {
+    Document {
+        key: Key::new("shared", "reports", id),
+        title: "İŞIK 東京".into(),
+        text: "Şirket sonucu 🦀".into(),
+        fields: [("nested".into(), serde_json::json!({"a":[1,null,"ü"]}))].into(),
+        links: vec![Key::new("shared", "funds", "ABC")],
+    }
+}
+fn put(document: Document) -> Mutation {
+    Mutation::Put {
+        document,
+        guard: Guard::Any,
+    }
+}
+
+#[test]
+fn reached_watermark_releases_delta_and_failed_validation_remains_atomic() {
+    let temp = Temp::new();
+    let options = Options {
+        max_delta_keys: 2,
+        max_delta_bytes: 16 * 1024 * 1024,
+    };
+    let mut db = Database::open_with_options(&temp.0, options.clone()).unwrap();
+    let a = document("a");
+    let b = document("b");
+    db.commit(vec![put(a.clone())]).unwrap();
+    let before = db.stats().unwrap();
+    assert_eq!(before.delta_keys, 1);
+    assert!(matches!(
+        db.commit(vec![put(b.clone()), put(b.clone())]),
+        Err(Error::Invalid(_))
+    ));
+    let after = db.stats().unwrap();
+    assert_eq!(after.sequence, before.sequence);
+    assert_eq!(after.log_bytes, before.log_bytes);
+    assert_eq!(after.generation, before.generation);
+    assert_eq!(db.get(&b.key).unwrap(), None);
+    assert_eq!(db.commit(vec![put(b.clone())]).unwrap(), 2);
+    let stats = db.stats().unwrap();
+    assert_eq!(stats.delta_keys, 0);
+    assert_eq!(stats.resident_documents, 0);
+    let mut query = Query::new("shared");
+    query.text = "isik sirket".into();
+    let page = db.search(&query).unwrap();
+    assert_eq!(page.total, 2);
+    assert_eq!(page.hits[0].document, a);
+    assert_eq!(page.hits[0].version, 1);
+    assert_eq!(page.hits[1].document, b);
+    assert_eq!(page.hits[1].version, 2);
+    db.commit(vec![Mutation::Delete {
+        key: a.key.clone(),
+        guard: Guard::Version { version: 1 },
+    }])
+    .unwrap();
+    let mut updated = b.clone();
+    updated.text = "güncel şirket".into();
+    db.commit(vec![Mutation::Put {
+        document: updated.clone(),
+        guard: Guard::Version { version: 2 },
+    }])
+    .unwrap();
+    drop(db);
+    let db = Database::open_with_options(&temp.0, options).unwrap();
+    assert!(db.get(&a.key).unwrap().is_none());
+    let found = db.get(&b.key).unwrap().unwrap();
+    assert_eq!(found.document, updated);
+    assert_eq!(found.version, 4);
+}
+
+#[test]
+fn byte_watermark_preserves_owned_documents_larger_than_streamed_admission() {
+    let temp = Temp::new();
+    let mut db = Database::open_with_options(
+        &temp.0,
+        Options {
+            max_delta_keys: 10_000,
+            max_delta_bytes: 1,
+        },
+    )
+    .unwrap();
+    let mut large = document("large");
+    large.text = "İŞIK 東京 🦀 ".repeat(20_000);
+    assert!(large.text.len() > 256 * 1024);
+    assert_eq!(db.commit(vec![put(large.clone())]).unwrap(), 1);
+    assert_eq!(db.stats().unwrap().delta_keys, 0);
+    drop(db);
+    assert_eq!(
+        Database::open(&temp.0)
+            .unwrap()
+            .get(&large.key)
+            .unwrap()
+            .unwrap()
+            .document,
+        large
+    );
+}
+
+#[test]
+fn failed_automatic_flush_poisoning_keeps_synced_transaction_recoverable() {
+    let temp = Temp::new();
+    let mut db = Database::open_with_options(
+        &temp.0,
+        Options {
+            max_delta_keys: 1,
+            max_delta_bytes: 16 * 1024 * 1024,
+        },
+    )
+    .unwrap();
+    let blocker = temp.0.join("run-0000000000000002.fdb");
+    fs::create_dir(&blocker).unwrap();
+    let original = document("recover");
+    assert!(matches!(
+        db.commit(vec![put(original.clone())]),
+        Err(Error::Io(_))
+    ));
+    assert!(matches!(db.get(&original.key), Err(Error::Poisoned)));
+    drop(db);
+    fs::remove_dir(blocker).unwrap();
+    let db = Database::open(&temp.0).unwrap();
+    let recovered = db.get(&original.key).unwrap().unwrap();
+    assert_eq!(recovered.document, original);
+    assert_eq!(recovered.version, 1);
+    assert_eq!(db.stats().unwrap().sequence, 1);
+}
