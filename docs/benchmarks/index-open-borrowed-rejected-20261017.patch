diff --git "a/src\\segment\\streaming\\borrowed_term.rs" "b/src\\segment\\streaming\\borrowed_term.rs"
new file mode 100644
index 0000000..42ff40a
--- /dev/null
+++ "b/src\\segment\\streaming\\borrowed_term.rs"
@@ -0,0 +1,185 @@
+//! Borrow directory strings from the bounded input entry and recycle order keys.
+//! This is only an opening-time representation; serialized Term is unchanged.
+use super::super::Term;
+use serde::Deserialize;
+use std::borrow::Cow;
+
+#[derive(Deserialize)]
+pub(super) enum TermRef<'a> {
+    Scope(#[serde(borrow)] Cow<'a, str>),
+    Collection(#[serde(borrow)] Cow<'a, str>, #[serde(borrow)] Cow<'a, str>),
+    Exact(
+        #[serde(borrow)] Cow<'a, str>,
+        #[serde(borrow)] Cow<'a, str>,
+        #[serde(borrow)] Cow<'a, str>,
+        #[serde(borrow)] Cow<'a, str>,
+    ),
+    Numeric(
+        #[serde(borrow)] Cow<'a, str>,
+        #[serde(borrow)] Cow<'a, str>,
+        #[serde(borrow)] Cow<'a, str>,
+        i64,
+    ),
+    Gram(#[serde(borrow)] Cow<'a, str>, #[serde(borrow)] Cow<'a, str>),
+    Link(#[serde(borrow)] KeyRef<'a>),
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct KeyRef<'a> {
+    #[serde(borrow)]
+    scope: Cow<'a, str>,
+    #[serde(borrow)]
+    collection: Cow<'a, str>,
+    #[serde(borrow)]
+    id: Cow<'a, str>,
+}
+fn copy(value: &str, target: &mut String) {
+    // Oversized legacy exact values remain supported but are not retained.
+    if target.capacity() > 64 * 1024 {
+        *target = String::new();
+    }
+    value.clone_into(target);
+}
+impl TermRef<'_> {
+    pub(super) fn assign(self, target: &mut Term) {
+        match (self, target) {
+            (Self::Scope(s), Term::Scope(a)) => copy(&s, a),
+            (Self::Collection(s, c), Term::Collection(a, b))
+            | (Self::Gram(s, c), Term::Gram(a, b)) => {
+                copy(&s, a);
+                copy(&c, b);
+            }
+            (Self::Exact(s, c, f, v), Term::Exact(a, b, d, e)) => {
+                copy(&s, a);
+                copy(&c, b);
+                copy(&f, d);
+                copy(&v, e);
+            }
+            (Self::Numeric(s, c, f, n), Term::Numeric(a, b, d, e)) => {
+                copy(&s, a);
+                copy(&c, b);
+                copy(&f, d);
+                *e = n;
+            }
+            (Self::Link(k), Term::Link(a)) => {
+                copy(&k.scope, &mut a.scope);
+                copy(&k.collection, &mut a.collection);
+                copy(&k.id, &mut a.id);
+            }
+            (value, target) => *target = value.into_owned(),
+        }
+    }
+    fn into_owned(self) -> Term {
+        match self {
+            Self::Scope(s) => Term::Scope(s.into_owned()),
+            Self::Collection(s, c) => Term::Collection(s.into_owned(), c.into_owned()),
+            Self::Gram(s, c) => Term::Gram(s.into_owned(), c.into_owned()),
+            Self::Exact(s, c, f, v) => Term::Exact(
+                s.into_owned(),
+                c.into_owned(),
+                f.into_owned(),
+                v.into_owned(),
+            ),
+            Self::Numeric(s, c, f, n) => {
+                Term::Numeric(s.into_owned(), c.into_owned(), f.into_owned(), n)
+            }
+            Self::Link(k) => Term::Link(crate::Key {
+                scope: k.scope.into_owned(),
+                collection: k.collection.into_owned(),
+                id: k.id.into_owned(),
+            }),
+        }
+    }
+}
+impl<'a> From<&'a Term> for TermRef<'a> {
+    fn from(term: &'a Term) -> Self {
+        match term {
+            Term::Scope(s) => Self::Scope(s.as_str().into()),
+            Term::Collection(s, c) => Self::Collection(s.as_str().into(), c.as_str().into()),
+            Term::Gram(s, c) => Self::Gram(s.as_str().into(), c.as_str().into()),
+            Term::Exact(s, c, f, v) => Self::Exact(
+                s.as_str().into(),
+                c.as_str().into(),
+                f.as_str().into(),
+                v.as_str().into(),
+            ),
+            Term::Numeric(s, c, f, n) => {
+                Self::Numeric(s.as_str().into(), c.as_str().into(), f.as_str().into(), *n)
+            }
+            Term::Link(k) => Self::Link(KeyRef {
+                scope: k.scope.as_str().into(),
+                collection: k.collection.as_str().into(),
+                id: k.id.as_str().into(),
+            }),
+        }
+    }
+}
+pub(in crate::segment) fn copy_owned(source: &Term, target: &mut Term) {
+    TermRef::from(source).assign(target);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn borrowed_schema_matches_every_owned_variant_escaping_and_order_keys() {
+        let mut cases = vec![
+            Term::Scope("şirket".into()),
+            Term::Collection("s".into(), "東京".into()),
+            Term::Exact(
+                "s".into(),
+                "c".into(),
+                "field".into(),
+                "quoted\"\\\n🦀".into(),
+            ),
+            Term::Numeric("s".into(), "c".into(), "n".into(), i64::MIN),
+            Term::Gram("s".into(), "the".into()),
+            Term::Link(crate::Key::new("s", "c", "id")),
+        ];
+        cases.extend(cases.clone());
+        cases.reverse();
+        let mut target = Term::Scope(String::new());
+        for expected in cases {
+            let bytes = serde_json::to_vec(&expected).unwrap();
+            for _ in 0..2 {
+                let value: TermRef<'_> = serde_json::from_slice(&bytes).unwrap();
+                value.assign(&mut target);
+                assert_eq!(target, expected);
+            }
+            let mut second = Term::Gram("old".into(), "old".into());
+            copy_owned(&target, &mut second);
+            assert_eq!(second, expected);
+        }
+        for bad in [
+            r#"{"Gram":["s","abc",0]}"#,
+            r#"{"Unknown":"s"}"#,
+            r#"{"Link":{"scope":"s","collection":"c","id":"i","extra":1}}"#,
+            r#"{"Link":{"scope":"s","collection":"c"}}"#,
+            r#"{"Numeric":["s","c","n",1.5]}"#,
+        ] {
+            assert!(serde_json::from_str::<Term>(bad).is_err());
+            assert!(serde_json::from_str::<TermRef<'_>>(bad).is_err());
+        }
+    }
+    #[test]
+    fn plain_strings_borrow_reuse_capacity_and_release_oversized_values() {
+        let value: TermRef<'_> = serde_json::from_str(r#"{"Gram":["şirket","東京🦀"]}"#).unwrap();
+        assert!(matches!(
+            value,
+            TermRef::Gram(Cow::Borrowed(_), Cow::Borrowed(_))
+        ));
+        let mut target = Term::Gram(String::with_capacity(64), String::with_capacity(64));
+        value.assign(&mut target);
+        let Term::Gram(s, c) = &target else { panic!() };
+        let pointers = (s.as_ptr(), c.as_ptr());
+        TermRef::Gram("s".into(), "abc".into()).assign(&mut target);
+        let Term::Gram(s, c) = &target else { panic!() };
+        assert_eq!(pointers, (s.as_ptr(), c.as_ptr()));
+        target = Term::Exact("s".into(), "c".into(), "f".into(), "x".repeat(256 * 1024));
+        TermRef::Exact("s".into(), "c".into(), "f".into(), "small".into()).assign(&mut target);
+        let Term::Exact(_, _, _, v) = target else {
+            panic!()
+        };
+        assert!(v.capacity() <= 64 * 1024);
+    }
+}
