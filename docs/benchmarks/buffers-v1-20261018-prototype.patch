+    /// The pool owns only the previous caller result, never a database cache.
+    #[cfg(feature = "bounded-engine")]
+    pub(crate) fn to_document_reusing(
+        &self,
+        pool: &mut std::vec::IntoIter<StoredDocument>,
+    ) -> Result<StoredDocument> {
+        #[cfg(feature = "diagnostic-timing")]
+        let _materialize = crate::timing::span("payload.materialize");
+        let mut text = pool
+            .next()
+            .map(|stored| stored.document.text)
+            .unwrap_or_default();
+        let (scope, collection, id) = self.key_parts();
+        let key = Key::new(scope, collection, id);
+        let title = self.title().to_owned();
+        {
+            #[cfg(feature = "diagnostic-timing")]
+            let _text = crate::timing::span("payload.copy_text");
+            text.clear();
+            // No spare documents survive a call. Bound unused text capacity
+            // when a previous large result slot now contains a small document.
+            if text.capacity() > self.text().len().saturating_mul(2).max(4096) {
+                text = String::new();
+            }
+            {
+                #[cfg(feature = "diagnostic-timing")]
+                let _reserve = crate::timing::span("payload.text_reserve");
+                text.reserve_exact(self.text().len());
+            }
+            {
+                #[cfg(feature = "diagnostic-timing")]
+                let _copy = crate::timing::span("payload.text_fill");
+                text.push_str(self.text());
+            }
+        }
+        Ok(StoredDocument {
+            document: Document {
+                key,
+                title,
+                text,
+                fields: fields(self.fields, true)?,
+                links: links(self.links, true)?,
+            },
+            version: self.version,
+        })
+    }
