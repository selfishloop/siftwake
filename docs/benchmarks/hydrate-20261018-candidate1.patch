+#[cfg(test)]
+mod owned_decode_tests {
+    use super::*;
+
+    #[test]
+    fn owned_decode_matches_checked_view_for_every_cut_and_byte_change() {
+        // Small unit fixture, independent of the existing benchmark corpus.
+        let expected = StoredDocument {
+            document: Document {
+                key: Key::new("shared", "texts", "şirket"),
+                title: "İstanbul 東京".into(),
+                text: "İŞIK 🦀 ȺΣ".repeat(4),
+                fields: BTreeMap::from([
+                    (
+                        "a".into(),
+                        serde_json::json!([null, true, -17, 1.25, u64::MAX]),
+                    ),
+                    ("z".into(), serde_json::json!({"nested": ["ş", false]})),
+                ]),
+                links: vec![Key::new("shared", "other", "対象")],
+            },
+            version: 17,
+        };
+        let bytes = encode(&expected).unwrap();
+        assert_eq!(decode_owned(&bytes).unwrap(), expected);
+        for cut in 0..bytes.len() {
+            assert!(checked(&bytes[..cut]).is_err(), "cut={cut}");
+            assert!(decode_owned(&bytes[..cut]).is_err(), "cut={cut}");
+        }
+        for at in 0..bytes.len() {
+            let mut changed = bytes.clone();
+            changed[at] ^= 0x80;
+            let reference = checked(&changed).and_then(|view| view.to_document());
+            let owned = decode_owned(&changed);
+            assert_eq!(owned.is_ok(), reference.is_ok(), "byte={at}");
+            if let (Ok(owned), Ok(reference)) = (owned, reference) {
+                assert_eq!(owned, reference, "byte={at}");
+            }
+        }
+        let legacy = serde_json::to_vec(&expected).unwrap();
+        assert_eq!(decode(&legacy).unwrap(), expected);
+        assert!(decode_owned(&legacy).is_err());
+    }
+}
