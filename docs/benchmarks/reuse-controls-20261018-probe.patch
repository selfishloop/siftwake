diff --git a/tools/bench_support/reuse_worker.rs b/tools/bench_support/reuse_worker.rs
new file mode 100644
--- /dev/null
+++ b/tools/bench_support/reuse_worker.rs
@@ -0,0 +1,247 @@
+//! Query history and reuse controls; no corpus or database writes.
+use crate::{input, matrix, reads};
+use fdb::{Database, Key, Query, SearchPage};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{
+    collections::BTreeSet,
+    io::{BufRead, Write},
+    path::Path,
+    time::Instant,
+};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Block {
+    id: u64,
+    seed: u64,
+    repeats: usize,
+    label: u8,
+    reuse: bool,
+    pattern: String,
+    case_indices: Vec<usize>,
+    get_interleave: bool,
+}
+impl Block {
+    fn validate(&self, count: usize) -> input::Result<()> {
+        let unique: BTreeSet<_> = self.case_indices.iter().copied().collect();
+        if !(1..=200).contains(&self.repeats)
+            || self.label > 2
+            || self.reuse != (self.label == 2)
+            || !matches!(self.pattern.as_str(), "mixed" | "single")
+            || self.case_indices.is_empty()
+            || self.case_indices.len() != unique.len()
+            || self.case_indices.iter().any(|&n| n >= count)
+        {
+            return Err("invalid reuse block".into());
+        }
+        Ok(())
+    }
+}
+fn shuffle<T>(items: &mut [T], state: &mut u64) {
+    for n in (1..items.len()).rev() {
+        *state ^= *state << 13;
+        *state ^= *state >> 7;
+        *state ^= *state << 17;
+        items.swap(n, *state as usize % (n + 1));
+    }
+}
+fn schedule(block: &Block) -> Vec<usize> {
+    let mut state = block.seed.wrapping_add(1);
+    let mut order = block.case_indices.clone();
+    let mut out = Vec::with_capacity(order.len() * block.repeats);
+    if block.pattern == "single" {
+        shuffle(&mut order, &mut state);
+        for n in order {
+            out.extend(std::iter::repeat_n(n, block.repeats));
+        }
+    } else {
+        for _ in 0..block.repeats {
+            shuffle(&mut order, &mut state);
+            out.extend(&order);
+        }
+    }
+    out
+}
+fn search(db: &Database, case: &matrix::Case, reuse: bool) -> fdb::Result<SearchPage> {
+    let mut q = Query::new("shared");
+    q.collection = Some("texts".into());
+    q.text = case.text.clone();
+    q.offset = case.offset;
+    q.limit = case.limit;
+    db.search_reuse_probe(&q, reuse)
+}
+fn check(matrix: &matrix::Matrix, case: &matrix::Case, page: &SearchPage) {
+    assert_eq!(page.sequence, 20);
+    assert_eq!(page.total, case.total);
+    assert_eq!(page.hits.len(), case.ids.len());
+    for (hit, id) in page.hits.iter().zip(&case.ids) {
+        assert_eq!(hit, &matrix.documents[id]);
+    }
+}
+fn gets(db: &Database, matrix: &matrix::Matrix) -> input::Result<()> {
+    for id in &matrix.gets {
+        assert_eq!(
+            db.get(&matrix.documents[id].document.key)?.as_ref(),
+            Some(&matrix.documents[id])
+        );
+    }
+    for key in [
+        Key::new("shared", "texts", "9999999999"),
+        Key::new("missing-scope", "texts", "0000000000"),
+        Key::new("shared", "missing-collection", "0000000000"),
+    ] {
+        assert!(db.get(&key)?.is_none());
+    }
+    Ok(())
+}
+pub fn run() -> input::Result<()> {
+    if cfg!(all(
+        feature = "diagnostic-memory",
+        feature = "diagnostic-timing"
+    )) {
+        return Err("run timing and allocation probes separately".into());
+    }
+    let path = Path::new("data/benchmark-work/fdb");
+    if !path.is_dir() {
+        return Err("existing fixed FDB slot required".into());
+    }
+    let matrix = matrix::Matrix::load()?;
+    println!(
+        "{}",
+        json!({"phase":"worker_ready", "cases":matrix.cases.len(),
+        "diagnostic_timing":cfg!(feature="diagnostic-timing"),
+        "diagnostic_memory":cfg!(feature="diagnostic-memory"), "database_between_blocks":false})
+    );
+    std::io::stdout().flush()?;
+    for line in std::io::stdin().lock().lines() {
+        let block: Block = serde_json::from_str(&line?)?;
+        block.validate(matrix.cases.len())?;
+        let start = Instant::now();
+        let db = Database::open(path)?;
+        let stats = db.stats()?;
+        assert_eq!(
+            (stats.documents, stats.delta_keys, stats.sequence),
+            (10000, 0, 20)
+        );
+        assert_eq!(db.pending_source_checks()?, 0);
+        println!(
+            "{}",
+            json!({"phase":"block_opened", "id":block.id,
+            "open_ms":start.elapsed().as_secs_f64()*1000., "outside_query_timing":true})
+        );
+        gets(&db, &matrix)?;
+        if block.pattern == "mixed" {
+            for &n in &block.case_indices {
+                check(
+                    &matrix,
+                    &matrix.cases[n],
+                    &search(&db, &matrix.cases[n], block.reuse)?,
+                );
+            }
+        }
+        let order = schedule(&block);
+        let mut samples = vec![Vec::with_capacity(block.repeats); matrix.cases.len()];
+        // Appended only in the separately compiled diagnostic variants.
+        #[allow(unused_mut)]
+        let mut profiles: Vec<Vec<Value>> = (0..matrix.cases.len())
+            .map(|_| Vec::with_capacity(block.repeats))
+            .collect();
+        let mut previous = None;
+        for (position, &n) in order.iter().enumerate() {
+            let case = &matrix.cases[n];
+            if block.pattern == "single" && previous != Some(n) {
+                check(&matrix, case, &search(&db, case, block.reuse)?);
+            }
+            previous = Some(n);
+            #[cfg(feature = "diagnostic-timing")]
+            drop(fdb::timing::take());
+            #[cfg(feature = "diagnostic-memory")]
+            let baseline = crate::allocation::reset();
+            let begin = Instant::now();
+            let page = search(&db, case, block.reuse)?;
+            let elapsed = begin.elapsed().as_secs_f64() * 1000.;
+            #[cfg(feature = "diagnostic-memory")]
+            let (live, peak, calls) = crate::allocation::snapshot();
+            #[cfg(feature = "diagnostic-timing")]
+            let counters = fdb::timing::take();
+            samples[n].push(elapsed);
+            #[cfg(feature = "diagnostic-memory")]
+            profiles[n].push(json!({"peak_requested_extra_bytes":peak.saturating_sub(baseline),
+                "live_requested_delta_bytes":live as i64 - baseline as i64, "allocation_calls":calls}));
+            #[cfg(feature = "diagnostic-timing")]
+            profiles[n].push(serde_json::to_value(counters)?);
+            check(&matrix, case, &page);
+            drop(page);
+            if block.get_interleave && (position + 1) % block.case_indices.len() == 0 {
+                gets(&db, &matrix)?;
+            }
+        }
+        let mut indices = block.case_indices.clone();
+        indices.sort_unstable();
+        let queries: Vec<_> = indices
+            .iter()
+            .map(|&n| {
+                let c = &matrix.cases[n];
+                let mut timing = reads::summary(&samples[n]);
+                let mut sorted = samples[n].clone();
+                sorted.sort_by(f64::total_cmp);
+                timing["p99_ms"] = json!(sorted[(sorted.len() * 99).div_ceil(100) - 1]);
+                json!({"case_index":n,"text":c.text,"offset":c.offset,"limit":c.limit,
+                "kind":c.kind,"total":c.total,"late_matches":c.late_matches,
+                "timing":timing,"profiles":profiles[n]})
+            })
+            .collect();
+        println!(
+            "{}",
+            json!({"phase":"reuse_block", "id":block.id,"label":block.label,
+            "reuse":block.reuse,"pattern":block.pattern,"seed":block.seed,"repeats":block.repeats,
+            "get_interleave":block.get_interleave,"order":order,"queries":queries,"full_document_checks":true})
+        );
+        assert_eq!(db.pending_source_checks()?, 0);
+        drop(db);
+        println!(
+            "{}",
+            json!({"phase":"block_done","id":block.id,"database_released":true})
+        );
+        std::io::stdout().flush()?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn schedule_balances_cases_and_rejects_invalid_commands() {
+        let mut b = Block {
+            id: 0,
+            seed: 42,
+            repeats: 7,
+            label: 0,
+            reuse: false,
+            pattern: "mixed".into(),
+            case_indices: vec![0, 11, 18, 20, 28, 31, 34, 37],
+            get_interleave: false,
+        };
+        for pattern in ["mixed", "single"] {
+            b.pattern = pattern.into();
+            b.validate(38).unwrap();
+            let s = schedule(&b);
+            assert_eq!(s, schedule(&b));
+            assert_eq!(s.len(), 56);
+            for n in &b.case_indices {
+                assert_eq!(s.iter().filter(|x| *x == n).count(), 7);
+            }
+            if pattern == "single" {
+                assert!(s.chunks(7).all(|v| v.iter().all(|x| *x == v[0])));
+            }
+        }
+        b.label = 2;
+        assert!(b.validate(38).is_err());
+        b.reuse = true;
+        b.validate(38).unwrap();
+        b.case_indices.push(0);
+        assert!(b.validate(38).is_err());
+    }
+}
