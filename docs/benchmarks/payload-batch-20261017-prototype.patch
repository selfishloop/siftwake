+#[cfg(feature = "bounded-engine")]
+#[test]
+fn known_candidate_batches_match_exact_reads_and_stay_within_window_budget() {
+    let temp = Temp::new();
+    let index = build(&temp);
+    for ids in [(0..64).collect::<Vec<_>>(), vec![0, 6, 18, 31, 63]] {
+        for terms in [
+            vec!["needle".into(), "istanbul".into()],
+            vec!["zx".into()],
+            vec!["needle".into(), "missing".into()],
+        ] {
+            let mut exact = QueryTextScratch::default();
+            let mut expected = 0;
+            for (bit, &id) in ids.iter().enumerate() {
+                if index
+                    .binary_exact_matches(id, &mut exact, &terms, &mut BTreeMap::new(), &mut 0)
+                    .unwrap()
+                {
+                    expected |= 1 << bit;
+                }
+            }
+            let mut batch = QueryTextScratch::default();
+            assert_eq!(
+                index
+                    .binary_candidate_batch(&ids, &mut batch, &terms, &mut BTreeMap::new(), &mut 0)
+                    .unwrap(),
+                expected
+            );
+            assert!(batch.payload.capacity() <= 128 * 1024);
+            #[cfg(feature = "diagnostic-timing")]
+            {
+                assert!(batch.reads.read_bytes * 100 <= batch.reads.requested_bytes * 105);
+                if ids.len() == 64 {
+                    assert!(batch.reads.requests < 10);
+                } else {
+                    assert_eq!(batch.reads.requests, ids.len() as u64);
+                }
+            }
+        }
+    }
+    for ids in [vec![0; 65], vec![0, 0], vec![2, 1], vec![64]] {
+        assert!(
+            index
+                .binary_candidate_batch(
+                    &ids,
+                    &mut QueryTextScratch::default(),
+                    &["needle".into()],
+                    &mut BTreeMap::new(),
+                    &mut 0
+                )
+                .is_err()
+        );
+    }
+    assert_eq!(
+        index
+            .binary_candidate_batch(
+                &[],
+                &mut QueryTextScratch::default(),
+                &[],
+                &mut BTreeMap::new(),
+                &mut 0
+            )
+            .unwrap(),
+        0
+    );
+}
