+#[cfg(feature = "bounded-engine")]
+#[test]
+fn known_candidate_batches_check_selected_crc_identity_and_cuts() {
+    let temp = Temp::new();
+    let mut builder = Builder::new(&temp.0, 7, 40, 0).unwrap();
+    let docs: Vec<_> = (0..5)
+        .map(|id| StoredDocument {
+            version: 7,
+            document: crate::Document {
+                key: Key::new("shared", "texts", &format!("{id:04}")),
+                title: "Şirket".into(),
+                text: format!(
+                    "needle İstanbul {}",
+                    "x".repeat(if id % 2 == 0 { 8192 } else { 20 })
+                ),
+                fields: BTreeMap::from([(
+                    "nested".into(),
+                    serde_json::json!([true,null,{"s":"😀"}]),
+                )]),
+                links: vec![Key::new("shared", "other", "link")],
+            },
+        })
+        .collect();
+    for doc in &docs {
+        builder.add(doc).unwrap();
+    }
+    drop(builder.finish().unwrap());
+    let mut index = DiskIndex::open_with_mode(&temp.0, None, false).unwrap();
+    let run = |index: &DiskIndex| {
+        let mut scratch = QueryTextScratch::default();
+        let result = index.binary_candidate_batch(
+            &[0, 2, 4],
+            &mut scratch,
+            &["needle".into(), "istanbul".into()],
+            &mut BTreeMap::new(),
+            &mut 0,
+        );
+        #[cfg(feature = "diagnostic-timing")]
+        if result.is_ok() {
+            assert_eq!(scratch.reads.requests, 1);
+        }
+        result
+    };
+    assert_eq!(run(&index).unwrap(), 7);
+    let mut file = OpenOptions::new().write(true).open(&temp.0).unwrap();
+    // A gap may be read but its document is not returned or parsed.
+    file.seek(SeekFrom::Start(index.records[1].offset)).unwrap();
+    file.write_all(&[255]).unwrap();
+    file.flush().unwrap();
+    assert_eq!(run(&index).unwrap(), 7);
+    let original = index.records[2];
+    for change_key in [false, true] {
+        let mut wrong = docs[2].clone();
+        if change_key {
+            wrong.document.key.id = "9999".into();
+        } else {
+            wrong.version += 1;
+        }
+        let bytes = crate::payload::encode(&wrong).unwrap();
+        assert_eq!(bytes.len(), original.len as usize);
+        index.records[2].checksum = crc(&bytes);
+        file.seek(SeekFrom::Start(original.offset)).unwrap();
+        file.write_all(&bytes).unwrap();
+        file.flush().unwrap();
+        assert!(matches!(run(&index), Err(Error::Corrupt(_))));
+    }
+    index.records[2] = original;
+    file.seek(SeekFrom::Start(original.offset)).unwrap();
+    file.write_all(&[255]).unwrap();
+    file.flush().unwrap();
+    assert!(matches!(run(&index), Err(Error::Corrupt(_))));
+    file.set_len(original.offset + 1).unwrap();
+    assert!(run(&index).is_err());
+}
