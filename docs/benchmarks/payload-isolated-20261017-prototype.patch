+    // Plan only known, visibility/intersection-filtered candidates. No speculative
+    // read-ahead: at most 64 slots and 128 KiB, at most 4 KiB per gap and 5% waste.
+    #[cfg(feature = "bounded-engine")]
+    #[inline(never)]
+    fn binary_candidate_batch(
+        &self,
+        ids: &[u32],
+        scratch: &mut QueryTextScratch,
+        terms: &[String],
+        cache: &mut BTreeMap<String, String>,
+        cached_bytes: &mut usize,
+    ) -> Result<u64> {
+        const WINDOW: usize = 128 * 1024;
+        if ids.len() > 64 || ids.windows(2).any(|w| w[0] >= w[1]) {
+            return Err(Error::Corrupt("invalid candidate batch order/size".into()));
+        }
+        let mut records = [None; 64];
+        for (slot, &id) in ids.iter().enumerate() {
+            if id as usize >= self.len() || self.deleted(id) {
+                return Err(Error::Corrupt("invalid candidate batch slot".into()));
+            }
+            records[slot] = Some(self.query_metadata(id, scratch)?);
+        }
+        let mut matches = 0;
+        let mut start = 0;
+        while start < ids.len() {
+            let first = records[start].unwrap();
+            if first.len as usize > WINDOW {
+                if self.binary_exact_matches(ids[start], scratch, terms, cache, cached_bytes)? {
+                    matches |= 1 << start;
+                }
+                start += 1;
+                continue;
+            }
+            let base = first.offset;
+            let mut end = base
+                .checked_add(first.len as u64)
+                .ok_or_else(|| Error::Corrupt("candidate batch payload overflow".into()))?;
+            let mut useful = first.len as u64;
+            let mut next = start + 1;
+            while next < ids.len() {
+                let r = records[next].unwrap();
+                let new_end = r
+                    .offset
+                    .checked_add(r.len as u64)
+                    .ok_or_else(|| Error::Corrupt("candidate batch payload overflow".into()))?;
+                if r.offset < end
+                    || r.offset - end > 4096
+                    || new_end - base > WINDOW as u64
+                    || (new_end - base - useful - r.len as u64) * 100 > (useful + r.len as u64) * 5
+                {
+                    break;
+                }
+                end = new_end;
+                useful += r.len as u64;
+                next += 1;
+            }
+            let len = (end - base) as usize;
+            // Exact reserve keeps this path's heap buffer within its byte budget.
+            if scratch.payload.capacity() < len {
+                scratch
+                    .payload
+                    .reserve_exact(len.saturating_sub(scratch.payload.len()));
+            }
+            scratch.payload.resize(len, 0);
+            {
+                #[cfg(feature = "diagnostic-timing")]
+                let _read = crate::timing::span("query.payload_read");
+                self.read_payload_at(base, &mut scratch.payload)?;
+            }
+            #[cfg(feature = "diagnostic-timing")]
+            {
+                scratch.reads.requests += 1;
+                scratch.reads.read_bytes += len as u64;
+                scratch.reads.requested_bytes += useful;
+                scratch.reads.hits += (next - start - 1) as u64;
+            }
+            let bytes = std::mem::take(&mut scratch.payload);
+            let result = (|| {
+                for slot in start..next {
+                    let r = records[slot].unwrap();
+                    let offset = (r.offset - base) as usize;
+                    let payload = &bytes[offset..offset + r.len as usize];
+                    {
+                        #[cfg(feature = "diagnostic-timing")]
+                        let _crc = crate::timing::span("query.payload_crc");
+                        if crc(payload) != r.checksum {
+                            return Err(Error::Corrupt(
+                                "segment document checksum mismatch".into(),
+                            ));
+                        }
+                    }
+                    let view = {
+                        #[cfg(feature = "diagnostic-timing")]
+                        let _validate = crate::timing::span("query.payload_validation");
+                        crate::payload::checked(payload)?
+                    };
+                    if view.version() != r.version
+                        || !self.query_identity(ids[slot], scratch, view.key_parts())?
+                    {
+                        return Err(Error::Corrupt("segment document identity mismatch".into()));
+                    }
+                    if scratch.matches_text(view.title(), view.text(), terms, cache, cached_bytes) {
+                        matches |= 1 << slot;
+                    }
+                }
+                Ok(())
+            })();
+            scratch.payload = bytes;
+            result?;
+            start = next;
+        }
+        Ok(matches)
+    }
