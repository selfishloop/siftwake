+    #[cfg(feature = "bounded-engine")]
+    fn candidate_batches(&self, seed: &[Posting], verification_terms: &[String]) -> bool {
+        #[cfg(feature = "experimental-rkyv-payload")]
+        if self.payload_benchmark.is_some() {
+            return false;
+        }
+        if verification_terms.is_empty() || !self.binary_payload {
+            return false;
+        }
+        let count = seed.iter().map(|p| p.count as u64).sum::<u64>();
+        count >= 64 && !self.broad_payload_seed(seed)
