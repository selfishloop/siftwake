+#[cfg(feature = "bounded-engine")]
+#[test]
+fn isolated_candidates_preserve_union_filters_visibility_and_prefix_order() {
+    let temp = Temp::new();
+    let mut builder = Builder::new(&temp.0, 7, 40, 0).unwrap();
+    let target = Key::new("shared", "targets", "one");
+    // Tiny unit fixture for the union/visibility contract, not a benchmark corpus.
+    for id in 0..256 {
+        let key = Key::new("shared", "texts", &format!("{id:04}"));
+        if id % 17 == 0 {
+            builder.add_delete(&key).unwrap();
+            continue;
+        }
+        builder
+            .add(&StoredDocument {
+                document: crate::Document {
+                    key,
+                    title: "İstanbul".into(),
+                    text: if id < 200 { "needle" } else { "other" }.into(),
+                    fields: BTreeMap::from([
+                        ("bucket".into(), serde_json::json!(id % 5)),
+                        ("keep".into(), serde_json::json!(id % 7 != 0)),
+                    ]),
+                    links: if id % 3 != 0 {
+                        vec![target.clone()]
+                    } else {
+                        vec![]
+                    },
+                },
+                version: 7,
+            })
+            .unwrap();
+    }
+    let index = builder.finish().unwrap();
+    let seed = index
+        .posting_range(
+            Term::Numeric("shared".into(), "texts".into(), "bucket".into(), 0),
+            Term::Numeric("shared".into(), "texts".into(), "bucket".into(), 1),
+        )
+        .unwrap();
+    assert_eq!(seed.len(), 2);
+    assert!(index.candidate_batches(&seed, &["needle".into()]));
+    assert!(!index.candidate_batches(&seed, &[]));
+    let mut query = Query::new("shared");
+    query.collection = Some("texts".into());
+    query.text = "needle İstanbul".into();
+    query.exact.insert("keep".into(), serde_json::json!(true));
+    query.ranges.push(crate::Range {
+        field: "bucket".into(),
+        min: 0,
+        max: 1,
+    });
+    query.linked_to = Some(target);
+    let expected: Vec<u32> = (0..200)
+        .filter(|id| id % 17 != 0 && id % 11 != 0 && id % 5 <= 1 && id % 7 != 0 && id % 3 != 0)
+        .collect();
+    assert_eq!(index.matches(&query, |id| id % 11 == 0).unwrap(), expected);
+    let mut mask = [0u64; 4];
+    for id in (0..256).step_by(11) {
+        mask[id / 64] |= 1 << (id % 64);
+    }
+    for limit in [1, 7, 40, 256] {
+        assert_eq!(
+            index.prefix_matches(&query, &mask, limit).unwrap(),
+            (
+                expected.len(),
+                expected.iter().copied().take(limit).collect()
+            )
+        );
+    }
+    query.text = "needle absent".into();
+    assert!(index.matches(&query, |_| false).unwrap().is_empty());
+}
