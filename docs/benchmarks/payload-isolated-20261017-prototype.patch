+    // Keep planning, queues and their stack frame out of the ordinary verifier.
+    #[cfg(feature = "bounded-engine")]
+    #[inline(never)]
+    fn visit_candidate_matches<const COUNT: bool>(
+        &self,
+        groups: &[Vec<Posting>],
+        terms: &[String],
+        _covered: bool,
+        hidden: impl Fn(u32) -> bool,
+        mut emit: impl FnMut(u32, usize),
+    ) -> Result<usize> {
+        #[cfg(feature = "diagnostic-timing")]
+        let mut work = crate::timing::QueryWork::default();
+        let mut cache_budget = 256 * 1024usize;
+        let mut cached = Vec::with_capacity(groups.len() - 1);
+        for group in &groups[1..] {
+            let count = group.iter().map(|p| p.count as usize).sum::<usize>();
+            if count <= 4096 && count * 4 <= cache_budget && count < self.len() {
+                cached.push(Some(self.read_small_group(group)?));
+                cache_budget -= count * 4;
+            } else {
+                cached.push(None);
+            }
+        }
+        let mut scratch = QueryTextScratch::default();
+        let mut folded_content = BTreeMap::new();
+        let mut folded_bytes = 0;
+        let mut total = 0;
+        let mut buffer = [0; 4096];
+        for (n, &p) in groups[0].iter().enumerate() {
+            let mut slot = 0;
+            let mut previous = None;
+            while slot < p.count {
+                let count = (p.count - slot).min((buffer.len() / 4) as u32);
+                self.read_at(
+                    p.offset + slot as u64 * 4,
+                    &mut buffer[..count as usize * 4],
+                )?;
+                let mut pending = [0u32; 64];
+                let mut pending_len = 0;
+                for bytes in buffer[..count as usize * 4].as_chunks::<4>().0 {
+                    let id = u32::from_le_bytes(*bytes);
+                    if id as usize >= self.len() || previous.is_some_and(|old| old >= id) {
+                        return Err(Error::Corrupt("invalid sorted posting list".into()));
+                    }
+                    previous = Some(id);
+                    if hidden(id) || self.deleted(id) {
+                        continue;
+                    }
+                    #[cfg(feature = "diagnostic-timing")]
+                    let intersection_start = std::time::Instant::now();
+                    let mut include = true;
+                    for (group, cached) in groups[1..].iter().zip(&cached) {
+                        let found = if let Some(ids) = cached {
+                            ids.binary_search(&id).is_ok()
+                        } else {
+                            self.group_contains(group, id)?
+                        };
+                        if !found {
+                            include = false;
+                            break;
+                        }
+                    }
+                    #[cfg(feature = "diagnostic-timing")]
+                    {
+                        work.visible += 1;
+                        work.intersection_ns += intersection_start.elapsed().as_nanos() as u64;
+                    }
+                    if !include {
+                        continue;
+                    }
+                    #[cfg(feature = "diagnostic-timing")]
+                    {
+                        if _covered {
+                            work.covered += 1;
+                        }
+                        work.candidates += 1;
+                    }
+                    pending[pending_len] = id;
+                    pending_len += 1;
+                    if pending_len == pending.len() {
+                        let accepted = self.binary_candidate_batch(
+                            &pending,
+                            &mut scratch,
+                            terms,
+                            &mut folded_content,
+                            &mut folded_bytes,
+                        )?;
+                        for (bit, &selected) in pending.iter().enumerate() {
+                            if accepted & (1 << bit) != 0 {
+                                #[cfg(feature = "diagnostic-timing")]
+                                {
+                                    work.accepted += 1;
+                                }
+                                if COUNT {
+                                    total += 1;
+                                }
+                                emit(selected, n);
+                            }
+                        }
+                        pending_len = 0;
+                    }
+                }
+                if pending_len != 0 {
+                    let accepted = self.binary_candidate_batch(
+                        &pending[..pending_len],
+                        &mut scratch,
+                        terms,
+                        &mut folded_content,
+                        &mut folded_bytes,
+                    )?;
+                    for (bit, &selected) in pending[..pending_len].iter().enumerate() {
+                        if accepted & (1 << bit) != 0 {
+                            #[cfg(feature = "diagnostic-timing")]
+                            {
+                                work.accepted += 1;
+                            }
+                            if COUNT {
+                                total += 1;
+                            }
+                            emit(selected, n);
+                        }
+                    }
+                }
+                slot += count;
+            }
+        }
+        Ok(total)
+    }
